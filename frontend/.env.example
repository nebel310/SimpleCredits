# Куда браузер шлёт запросы. /api проксируется на бэкенд (Vite при разработке, nginx в Docker)
VITE_API_URL=/api
# Только для npm run dev: где запущен бэкенд
BACKEND_URL=http://localhost:3001
# Администратор для кнопки «Войти как банк» — те же значения, что ADMIN_EMAIL / ADMIN_PASSWORD в .env бэкенда
VITE_ADMIN_EMAIL=admin@admin.com
VITE_ADMIN_PASSWORD=admin
