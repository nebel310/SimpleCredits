# # ===== Database =====
# POSTGRES_USER=simplecredits
# POSTGRES_PASSWORD=simplecredits
# POSTGRES_DB=simplecredits
# DATABASE_URL=postgresql+asyncpg://simplecredits:simplecredits@db:5432/simplecredits

# # ===== JWT =====
# SECRET_KEY=change-me-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# # ===== MinIO / S3 =====
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET_NAME=simplecredits-files

# # ===== ML gRPC =====
# ML_GRPC_HOST=ml
# ML_GRPC_PORT=50051
# ML_GRPC_TIMEOUT=10.0

# # ===== Admin =====
# # Создаётся в lifespan, если пользователя с таким email ещё нет
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=admin
# ADMIN_USERNAME=admin